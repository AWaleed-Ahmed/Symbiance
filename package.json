{
  "name": "symbiance",
  "version": "0.2.0",
  "private": true,
  "description": "Firefox watch rooms with automatic connection recovery",
  "author": "Symbiance contributors",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/server.js",
    "test": "node --test tests/*.test.js",
    "extension:build": "node scripts/extension.js build",
    "extension:sign": "node scripts/extension.js sign",
    "assets": "node scripts/assets.js",
    "native:build": "pkg desktop/native-host.js --target node22-win-x64 --output assets/win32/native/symbiance-bridge.exe",
    "native:build:linux": "pkg desktop/native-host.js --target node22-linux-x64 --output assets/linux/native/symbiance-bridge",
    "build:win": "npm run assets -- win32 && npm run native:build && npm run extension:build && electron-builder --win portable nsis --x64 --publish never",
    "build:win:portable": "npm run assets -- win32 && npm run native:build && npm run extension:build && electron-builder --win portable --x64 --publish never",
    "build:linux": "npm run assets -- linux && npm run native:build:linux && npm run extension:build && electron-builder --linux deb tar.gz --x64 --publish never",
    "release:prepare": "node scripts/prepare-release.js",
    "test:ui": "node scripts/test-ui.js",
    "test:packaged": "node scripts/test-packaged.js",
    "test:compatibility": "node scripts/test-compatibility.js"
  },
  "build": {
    "appId": "com.symbiance.desktop",
    "productName": "Symbiance",
    "directories": { "output": "dist" },
    "files": ["desktop/**/*", "server/relay.js", "package.json"],
    "extraResources": [
      { "from": "assets/licenses", "to": "licenses" },
      { "from": "assets/extension", "to": "extension", "filter": ["*.xpi"] },
      { "from": "THIRD-PARTY.txt", "to": "THIRD-PARTY.txt" }
    ],
    "win": {
      "extraResources": [
        { "from": "assets/win32/cloudflared.exe", "to": "cloudflared.exe" },
        { "from": "assets/win32/native", "to": "native" }
      ],
      "target": ["portable", "nsis"],
      "signAndEditExecutable": false,
      "artifactName": "Symbiance-${version}-${arch}.${ext}"
    },
    "portable": { "artifactName": "Symbiance-${version}-${arch}-portable.exe" },
    "nsis": { "artifactName": "Symbiance-${version}-${arch}-setup.exe", "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true },
    "linux": {
      "target": ["deb", "tar.gz"],
      "category": "AudioVideo",
      "maintainer": "Symbiance contributors <symbiance@awaleed-ahmed.github.io>",
      "artifactName": "Symbiance-${version}-${arch}.${ext}",
      "extraResources": [
        { "from": "assets/linux/cloudflared", "to": "cloudflared" },
        { "from": "assets/linux/native", "to": "native" }
      ]
    }
  },
  "dependencies": {
    "lucide": "^1.49.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@yao-pkg/pkg": "^6.23.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "web-ext": "^10.7.0"
  }
}
